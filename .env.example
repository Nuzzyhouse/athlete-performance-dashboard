# Copy this file to .env and fill in your own values. Never commit .env.

# Postgres connection string — use the UNPOOLED / direct connection string
# (e.g. Neon's non "-pooler" host), not a pgbouncer/pooled one.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth — generate with: npx auth secret
AUTH_SECRET=""

# VALD ForceDecks API credentials (org ID + signed license agreement required)
VALD_CLIENT_ID=""
VALD_CLIENT_SECRET=""
VALD_TENANT_REGION="use"

# Shared secret your scheduler must send as a header to trigger the nightly sync
CRON_SECRET=""

# IANA timezone the club/facility is in — used for all "today" date rendering
CLUB_TIMEZONE="America/New_York"
